generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String?    @unique
  phone      String?    @unique
  password   String?
  role       Role       @default(CONSUMER)
  isVerified Boolean    @default(false)
  isBlocked  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  blogPosts  BlogPost[]
  leads      Lead[]

  @@index([role])
}

model Township {
  id           String    @id @default(cuid())
  name         String
  description  String?
  locality     String
  city         String    @default("Mumbai")
  address      String    @default("")
  latitude     Float?
  longitude    Float?
  googleMapUrl String?
  slug         String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  projects     Project[]
}

model Project {
  id                   String                 @id @default(cuid())
  title                String
  slug                 String                 @unique
  description          String?
  propertyType         PropertyType           @default(APARTMENT)
  constructionStatus   ConstructionStatus     @default(UNDER_CONSTRUCTION)
  propertyView         PropertyView           @default(NONE)
  videoUrl             String?
  address              String?                @default("")
  googleMapUrl         String?
  latitude             Float?
  longitude            Float?
  featured             Boolean                @default(false)
  status               ProjectStatus          @default(ACTIVE)
  townshipId           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  leads                Lead[]
  township             Township?              @relation(fields: [townshipId], references: [id])
  amenities            ProjectAmenity[]
  configurations       ProjectConfiguration[]
  media                ProjectMedia[]
}

model ProjectMedia {
  id              String                @id @default(cuid())
  projectId       String
  configurationId String?
  url             String
  type            MediaType             @default(IMAGE)
  isCover         Boolean               @default(false)
  sortOrder       Int                   @default(0)
  createdAt       DateTime              @default(now())
  configuration   ProjectConfiguration? @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Amenity {
  id       String           @id @default(cuid())
  name     String           @unique
  category String           @default("General")
  projects ProjectAmenity[]
}

model ProjectAmenity {
  id        String   @id @default(cuid())
  projectId String
  amenityId String
  createdAt DateTime @default(now())
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Lead {
  id            String     @id @default(cuid())
  userId        String?
  name          String
  phone         String
  type          LeadType
  message       String?
  preferredDate DateTime?
  preferredSlot String?
  status        LeadStatus @default(NEW)
  createdAt     DateTime   @default(now())
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id])
  user          User?      @relation(fields: [userId], references: [id])

  @@index([phone])
  @@index([type])
  @@index([status])
}

model BlogPost {
  id          String    @id @default(cuid())
  authorId    String
  title       String
  slug        String    @unique
  coverImage  String?
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])

  @@index([published])
  @@index([slug])
}

model ProjectConfiguration {
  id               String         @id @default(cuid())
  projectId        String
  bhk              Int            @default(1)
  carpetArea       Float          @default(0)
  builtUpArea      Float?
  superBuiltUpArea Float?
  pricePerSqft     Float          @default(0)
  totalPrice       Float          @default(0)
  label            String?
  availableUnits   Int?
  isAvailable      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now())
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floorPlans       ProjectMedia[]
}

enum Role {
  ADMIN
  CONSUMER
}

enum PropertyType {
  FLAT
  BUNGALOW
  VILLA
  PLOT
  ROW_HOUSE
  COMMERCIAL
  APARTMENT
}

enum MediaType {
  IMAGE
  BROCHURE
  FLOOR_PLAN
}

enum ProjectStatus {
  ACTIVE
  SOLD_OUT
  UPCOMING
  INACTIVE
}

enum ConstructionStatus {
  UNDER_CONSTRUCTION
  READY_TO_MOVE
  NEW_LAUNCH
  NONE
}

enum LeadType {
  CALLBACK
  SITE_VISIT
  VIDEO_TOUR
  SELL_REQUEST
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
  CANCELLED
}

enum PropertyStatus {
  ACTIVE
  SOLD
  INACTIVE
}

enum PropertyView {
  GARDEN
  POOL
  LAKE
  CITY
  NONE
}
