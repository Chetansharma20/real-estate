generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Role {
  ADMIN
  CONSUMER
}

enum PropertyType {
  FLAT
  BUNGALOW
  VILLA
  PLOT
  ROW_HOUSE
  COMMERCIAL
}

enum PriceType {
  SALE
}

enum PropertyStatus {
  ACTIVE
  SOLD
  INACTIVE
}

enum PropertyTag {
  SEA_VIEW
  CITY_VIEW
  GREEN_VIEW
  NONE
}

enum ConstructionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
  NONE
}

enum LeadType {
  CALLBACK
  SITE_VISIT
  VIDEO_TOUR
  SELL_REQUEST
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
  CANCELLED
}

// ------------------------------------------------------------
// Users
// ------------------------------------------------------------

model User {
  id         String   @id @default(cuid())
  name       String
  email      String?  @unique
  phone      String?  @unique
  password   String?
  role       Role     @default(CONSUMER)
  isVerified Boolean  @default(false)
  isBlocked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leads     Lead[]
  blogPosts BlogPost[]

  @@index([role])
}

// ------------------------------------------------------------
// Properties
// ------------------------------------------------------------

model Property {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  type        PropertyType
  priceType   PriceType
  bhk         Int
  status              PropertyStatus     @default(ACTIVE)
  isFeatured          Boolean            @default(false)
  tag                 PropertyTag        @default(NONE)
  constructionStatus  ConstructionStatus @default(NONE)
  reraId              String?

  locality String
  city     String @default("Mumbai")
  address  String
  lat      Float?
  lng      Float?
  mapUrl   String?

  carpetArea       Float
  builtUpArea      Float?
  superBuiltUpArea Float?

  basePrice           Decimal  @db.Decimal(12, 2)
  gst                 Decimal? @db.Decimal(12, 2)
  stampDuty           Decimal? @db.Decimal(12, 2)
  registrationCharges Decimal? @db.Decimal(12, 2)
  otherCharges        Decimal? @db.Decimal(12, 2)

  images    PropertyImage[]
  amenities PropertyAmenity[]
  leads     Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locality])
  @@index([city])
  @@index([status])
  @@index([priceType, bhk])
  @@index([basePrice])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  order      Int      @default(0)

  @@index([propertyId])
}

// ------------------------------------------------------------
// Amenities
// ------------------------------------------------------------

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

// ------------------------------------------------------------
// Leads — single table for callback, site visit, video tour, sell request
// ------------------------------------------------------------

model Lead {
  id            String     @id @default(cuid())
  propertyId    String?
  property      Property?  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?      @relation(fields: [userId], references: [id])

  name          String
  phone         String
  type          LeadType
  message       String?    @db.Text
  preferredDate DateTime?
  preferredSlot String?
  status        LeadStatus @default(NEW)
  createdAt     DateTime   @default(now())

  @@index([propertyId])
  @@index([phone])
  @@index([type])
  @@index([status])
}

// ------------------------------------------------------------
// Blog
// ------------------------------------------------------------

model BlogPost {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  title       String
  slug        String    @unique
  coverImage  String?
  content     String    @db.Text
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published])
  @@index([slug])
}